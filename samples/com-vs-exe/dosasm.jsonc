{
    "$schema": "https://raw.githubusercontent.com/dosasm/masm-tasm/refs/heads/v2/dev/dosasm-action/v1.schema.json",
    "action": {
        "copyFileAs": null,
        "before": [
            "mount c ${<built-in>/TASM.jsdos}",
            "mount d ${actionFolder}",
            "PATH %PATH%;C:\\TASM",
            "d:",
            "cd d:\\"
        ],
        "open": [],
        "run": [
            "TASM comhello.asm",
            "TLINK /t comhello.obj",
            "comhello.com",
            "pause"
        ],
        "debug": [
            "TASM /zi comhello.asm",
            "TLINK /t/v/3 comhello.obj",
            "copy C:\\TASM\\TDC2.TD TDCONFIG.TD",
            "TD -cTDCONFIG.TD comhello.com"
        ]
    }
}